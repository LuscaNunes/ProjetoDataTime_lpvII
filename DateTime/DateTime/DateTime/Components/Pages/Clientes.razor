@page "/clientes"
@using Microsoft.EntityFrameworkCore
@using DateTime.Data
@using DateTime.Models
@inject IDbContextFactory<AppDbContext> Factory
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Clientes</h3>
    <a class="btn btn-primary" href="/clientes/novo">
        <i class="bi bi-plus-circle"></i> Novo Cliente
    </a>
</div>

@if (clientes == null)
{
    <p><em>Carregando...</em></p>
}
else if (clientes.Count == 0)
{
    <div class="alert alert-info">Nenhum cliente cadastrado.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th>E-mail</th>
            <th style="width: 180px;">Ações</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in clientes)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Nome</td>
                <td>@c.Telefone</td>
                <td>@c.Email</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-2" href="@($"/clientes/editar/{c.Id}")">
                        Editar
                    </a>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Excluir(c.Id)">
                        Excluir
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    List<Cliente>? clientes;

    protected override async Task OnInitializedAsync()
    {
        await CarregarClientes();
    }

    async Task CarregarClientes()
    {
        using var db = await Factory.CreateDbContextAsync();
        clientes = await db.Clientes.ToListAsync();
    }

    async Task Excluir(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este cliente?");
        if (!confirmado) return;

        using var db = await Factory.CreateDbContextAsync();
        var item = await db.Clientes.FindAsync(id);
        if (item != null)
        {
            db.Clientes.Remove(item);
            await db.SaveChangesAsync();
            await CarregarClientes();
        }
    }
}
