@page "/agendamentos"
@using Microsoft.EntityFrameworkCore
@using DateTime.Data
@using DateTime.Models
@inject IDbContextFactory<AppDbContext> Factory
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Agendamentos</h3>
    <a class="btn btn-primary" href="/agendamentos/novo">
        <i class="bi bi-plus-circle"></i> Novo Agendamento
    </a>
</div>

@if (agendamentos == null)
{
    <p><em>Carregando...</em></p>
}
else if (agendamentos.Count == 0)
{
    <div class="alert alert-info">Nenhum agendamento cadastrado.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Data / Hora</th>
            <th>Serviço</th>
            <th>Cliente</th>
            <th>Profissional</th>
            <th>Status</th>
            <th style="width: 180px;">Ações</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var a in agendamentos)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@a.Servico</td>
                <td>@(a.Cliente?.Nome ?? "-")</td>
                <td>@(a.Profissional?.Nome ?? "-")</td>
                <td>
                    <span class="badge @ObterBadgeStatus(a.Status)">@a.Status</span>
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-2" href="@($"/agendamentos/editar/{a.Id}")">
                        Editar
                    </a>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Excluir(a.Id)">
                        Excluir
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    List<Agendamento>? agendamentos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAgendamentos();
    }

    async Task CarregarAgendamentos()
    {
        using var db = await Factory.CreateDbContextAsync();
        agendamentos = await db.Agendamentos
            .Include(a => a.Cliente)
            .Include(a => a.Profissional)
            .OrderByDescending(a => a.DataHora)
            .ToListAsync();
    }

    async Task Excluir(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este agendamento?");
        if (!confirmado) return;

        using var db = await Factory.CreateDbContextAsync();
        var item = await db.Agendamentos.FindAsync(id);
        if (item != null)
        {
            db.Agendamentos.Remove(item);
            await db.SaveChangesAsync();
            await CarregarAgendamentos();
        }
    }

    string ObterBadgeStatus(string status) => status switch
    {
        "Concluído" => "bg-success",
        "Cancelado" => "bg-danger",
        "Em Andamento" => "bg-warning text-dark",
        _ => "bg-primary"
    };
}
