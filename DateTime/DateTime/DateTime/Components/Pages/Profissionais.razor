@page "/profissionais"
@using Microsoft.EntityFrameworkCore
@using DateTime.Data
@using DateTime.Models
@inject IDbContextFactory<AppDbContext> Factory
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Profissionais</h3>
    <a class="btn btn-primary" href="/profissionais/novo">
        <i class="bi bi-plus-circle"></i> Novo Profissional
    </a>
</div>

@if (profissionais == null)
{
    <p><em>Carregando...</em></p>
}
else if (profissionais.Count == 0)
{
    <div class="alert alert-info">Nenhum profissional cadastrado.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Nome</th>
            <th>Especialidade</th>
            <th style="width: 180px;">Ações</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var p in profissionais)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@p.Especialidade</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary me-2" href="@($"/profissionais/editar/{p.Id}")">
                        Editar
                    </a>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Excluir(p.Id)">
                        Excluir
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    List<Profissional>? profissionais;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProfissionais();
    }

    async Task CarregarProfissionais()
    {
        using var db = await Factory.CreateDbContextAsync();
        profissionais = await db.Profissionais.ToListAsync();
    }

    async Task Excluir(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir este profissional?");
        if (!confirmado) return;

        using var db = await Factory.CreateDbContextAsync();
        var item = await db.Profissionais.FindAsync(id);
        if (item != null)
        {
            db.Profissionais.Remove(item);
            await db.SaveChangesAsync();
            await CarregarProfissionais();
        }
    }
}
